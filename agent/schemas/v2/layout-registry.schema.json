{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ppt-agent/schemas/v2/layout-registry.schema.json",
  "title": "Layout Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "canvas", "layouts"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "registry_id": { "type": "string", "minLength": 1 },
    "canvas": { "$ref": "#/$defs/frame" },
    "layouts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layout" } }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_id", "family", "version", "compatible_narrative_roles", "compatible_content_types", "use_when", "avoid_when", "density_budget", "typography_budget", "slots", "renderer_key"],
      "properties": {
        "layout_id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+\\.v[0-9]+$" },
        "family": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "compatible_narrative_roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "compatible_content_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "compatible_visual_types": { "type": "array", "items": { "type": "string" }, "default": [] },
        "use_when": { "type": "array", "items": { "type": "string" } },
        "avoid_when": { "type": "array", "items": { "type": "string" } },
        "density_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "max_text_characters", "max_content_items", "max_asset_slots"],
          "properties": {
            "level": { "enum": ["sparse", "low", "medium", "high"] },
            "max_text_characters": { "type": "integer", "minimum": 0 },
            "max_content_items": { "type": "integer", "minimum": 1 },
            "max_asset_slots": { "type": "integer", "minimum": 0 }
          }
        },
        "typography_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title_min_pt", "body_min_pt"],
          "properties": {
            "title_min_pt": { "type": "number", "minimum": 20 },
            "body_min_pt": { "type": "number", "minimum": 10 },
            "caption_min_pt": { "type": "number", "minimum": 8, "default": 10 }
          }
        },
        "slots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slot" } },
        "fallback_layout_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "preview_path": { "type": ["string", "null"], "default": null },
        "renderer_key": { "type": "string", "minLength": 1 }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "role", "accepts", "required", "frame"],
      "properties": {
        "slot_id": { "type": "string", "pattern": "^slot-[a-z0-9-]+$" },
        "role": { "enum": ["title", "subtitle", "key-message", "body", "metric", "visual", "chart", "caption", "source", "decorative"] },
        "accepts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "required": { "type": "boolean" },
        "frame": { "$ref": "#/$defs/frame" },
        "capacity": { "type": "object" },
        "fit_policy": { "enum": ["fixed", "shrink-within-budget", "truncate", "reflow", "crop", "contain", "cover"] },
        "style_ref": { "type": "string", "minLength": 1, "default": "body" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
