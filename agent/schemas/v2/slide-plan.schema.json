{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ppt-agent/schemas/v2/slide-plan.schema.json",
  "title": "Semantic Slide Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "language", "communication_job", "design_system_id", "slides"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "deck_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "communication_job": { "$ref": "#/$defs/communication_job" },
    "design_system_id": { "type": "string", "minLength": 1 },
    "global_constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" }, "default": [] },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slide" } }
  },
  "$defs": {
    "communication_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "audience_outcome", "central_takeaway", "deck_mode"],
      "properties": {
        "audience": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "audience_outcome": { "type": "string", "minLength": 1 },
        "central_takeaway": { "type": "string", "minLength": 1 },
        "deck_mode": { "enum": ["structured-argument", "visual-narrative", "reference", "instructional", "decision-support"] }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slide_id", "slide_number", "narrative_role", "content_type", "communication_goal", "action_title", "key_message", "content", "visual_brief", "layout_preferences", "density_budget"],
      "properties": {
        "slide_id": { "type": "string", "pattern": "^slide-[0-9]{3}$" },
        "slide_number": { "type": "integer", "minimum": 1 },
        "narrative_role": { "enum": ["opening", "orientation", "context", "problem", "question", "evidence", "explanation", "comparison", "transition", "recommendation", "summary", "closing", "appendix"] },
        "content_type": { "enum": ["headline", "bullet-list", "metric", "comparison", "process", "timeline", "chart", "image", "quote", "table", "mixed"] },
        "communication_goal": { "type": "string", "minLength": 1 },
        "action_title": { "type": "string", "minLength": 1 },
        "key_message": { "type": "string", "minLength": 1 },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/content_block" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "default": [] },
        "visual_brief": { "$ref": "#/$defs/visual_brief" },
        "layout_preferences": { "$ref": "#/$defs/layout_preferences" },
        "density_budget": { "$ref": "#/$defs/density_budget" },
        "speaker_notes": { "type": "string", "default": "" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" }, "default": [] },
        "revision_history": { "type": "array", "items": { "type": "object" }, "default": [] }
      }
    },
    "content_block": {
      "oneOf": [
        { "$ref": "#/$defs/text_block" },
        { "$ref": "#/$defs/metric_block" },
        { "$ref": "#/$defs/comparison_block" },
        { "$ref": "#/$defs/sequence_block" },
        { "$ref": "#/$defs/chart_block" },
        { "$ref": "#/$defs/image_block" },
        { "$ref": "#/$defs/table_block" }
      ]
    },
    "block_base": {
      "type": "object",
      "required": ["block_id", "type", "priority"],
      "properties": {
        "block_id": { "type": "string", "pattern": "^block-[a-z0-9-]+$" },
        "type": { "type": "string" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "source_ids": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "text_block": {
      "allOf": [
        { "$ref": "#/$defs/block_base" },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "enum": ["headline", "paragraph", "bullet-list", "quote", "callout"] },
            "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "metric_block": {
      "allOf": [
        { "$ref": "#/$defs/block_base" },
        {
          "type": "object",
          "required": ["type", "value", "label"],
          "properties": {
            "type": { "const": "metric" },
            "value": { "type": ["number", "string"] },
            "unit": { "type": "string", "default": "" },
            "label": { "type": "string", "minLength": 1 },
            "context": { "type": "string", "default": "" },
            "trend": { "enum": ["up", "down", "flat", "none"], "default": "none" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "comparison_block": {
      "allOf": [
        { "$ref": "#/$defs/block_base" },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "comparison" },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "points"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "points": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "asset_id": { "type": ["string", "null"], "default": null }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sequence_block": {
      "allOf": [
        { "$ref": "#/$defs/block_base" },
        {
          "type": "object",
          "required": ["type", "steps"],
          "properties": {
            "type": { "enum": ["process", "timeline"] },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "description"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "description": { "type": "string" },
                  "marker": { "type": ["string", "null"], "default": null }
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "chart_block": {
      "allOf": [
        { "$ref": "#/$defs/block_base" },
        {
          "type": "object",
          "required": ["type", "chart_type", "data", "insight"],
          "properties": {
            "type": { "const": "chart" },
            "chart_type": { "enum": ["bar", "column", "line", "area", "scatter", "donut", "waterfall", "funnel", "heatmap", "table"] },
            "data": { "type": "object" },
            "insight": { "type": "string", "minLength": 1 },
            "highlight": { "type": ["object", "null"], "default": null }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "image_block": {
      "allOf": [
        { "$ref": "#/$defs/block_base" },
        {
          "type": "object",
          "required": ["type", "asset_id"],
          "properties": {
            "type": { "const": "image" },
            "asset_id": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "default": "" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "table_block": {
      "allOf": [
        { "$ref": "#/$defs/block_base" },
        {
          "type": "object",
          "required": ["type", "columns", "rows"],
          "properties": {
            "type": { "const": "table" },
            "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "rows": { "type": "array", "minItems": 1, "items": { "type": "array" } },
            "insight": { "type": "string", "default": "" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "claim", "source_id"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "display_citation": { "type": "string", "default": "" }
      }
    },
    "visual_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "preferred_medium", "asset_required"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "preferred_medium": { "enum": ["none", "photo", "illustration", "diagram", "chart", "table", "icon", "mixed"] },
        "asset_required": { "type": "boolean" },
        "subject": { "type": ["string", "null"], "default": null },
        "aspect_ratio": { "enum": ["16:9", "21:9", "16:10", "4:3", "3:2", "1:1", "portrait", "auto"] },
        "focal_position": { "enum": ["left", "center", "right", "top", "bottom", "auto"], "default": "auto" },
        "style_notes": { "type": "string", "default": "" },
        "fallback": { "enum": ["text-only", "diagram", "abstract-shape", "change-layout", "none"], "default": "change-layout" }
      }
    },
    "layout_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_families"],
      "properties": {
        "preferred_families": { "type": "array", "items": { "type": "string" }, "default": [] },
        "avoid_families": { "type": "array", "items": { "type": "string" }, "default": [] },
        "preferred_layout_ids": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "density_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "max_body_characters", "max_content_items"],
      "properties": {
        "level": { "enum": ["sparse", "low", "medium", "high"] },
        "max_body_characters": { "type": "integer", "minimum": 0 },
        "max_content_items": { "type": "integer", "minimum": 1 },
        "min_body_size_pt": { "type": "number", "minimum": 10, "default": 16 }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "type", "description", "severity"],
      "properties": {
        "constraint_id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["language", "style", "content", "layout", "brand", "accessibility", "source"] },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["must", "should", "nice-to-have"] }
      }
    }
  }
}
