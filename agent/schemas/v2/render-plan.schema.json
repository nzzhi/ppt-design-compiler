{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ppt-agent/schemas/v2/render-plan.schema.json",
  "title": "Render Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "source_slide_plan_version", "design_system_id", "layout_registry_id", "slides"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "deck_id": { "type": "string", "minLength": 1 },
    "source_slide_plan_version": { "type": "string", "minLength": 1 },
    "design_system_id": { "type": "string", "minLength": 1 },
    "layout_registry_id": { "type": "string", "minLength": 1 },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/render_slide" } }
  },
  "$defs": {
    "render_slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slide_id", "layout_id", "layout_score", "elements", "fit_status"],
      "properties": {
        "slide_id": { "type": "string", "pattern": "^slide-[0-9]{3}$" },
        "layout_id": { "type": "string", "minLength": 1 },
        "layout_score": { "type": "number", "minimum": 0 },
        "selection_reasons": { "type": "array", "items": { "type": "string" }, "default": [] },
        "elements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/render_element" } },
        "fit_status": { "enum": ["pass", "warning", "failed"] },
        "fit_issues": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    },
    "render_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "slot_id", "element_type", "content_ref", "frame", "style_ref", "z_order"],
      "properties": {
        "element_id": { "type": "string", "pattern": "^el-[a-z0-9-]+$" },
        "slot_id": { "type": "string", "pattern": "^slot-[a-z0-9-]+$" },
        "element_type": { "enum": ["text", "shape", "image", "chart", "table", "group"] },
        "content_ref": { "type": ["string", "null"] },
        "frame": { "$ref": "#/$defs/frame" },
        "style_ref": { "type": "string", "minLength": 1 },
        "z_order": { "type": "integer", "minimum": 0 },
        "crop": { "type": ["object", "null"], "default": null },
        "locked": { "type": "boolean", "default": false },
        "actual_shape_id": { "type": ["string", "null"], "default": null }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "unit"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["in", "px"] }
      }
    }
  }
}
