{
  "theme_id": "tech-roadshow.v1",
  "name": "Tech Roadshow",
  "use_cases": ["product_pitch", "startup_roadshow", "technology_solution", "demo_intro"],
  "audience": ["investors", "customers", "technical_decision_makers"],
  "tone": ["confident", "visual", "forward-looking"],
  "palette": {
    "background": "#0B1020",
    "surface": "#151C2F",
    "text_primary": "#F8FAFC",
    "text_secondary": "#B8C2D6",
    "accent_primary": "#2DD4BF",
    "accent_secondary": "#8B5CF6",
    "warning": "#F59E0B",
    "divider": "#2B3448"
  },
  "typography": {
    "preferred_fonts": ["Microsoft YaHei", "Aptos Display", "Arial"],
    "title_weight": 700,
    "body_weight": 400,
    "min_body_size_pt": 16,
    "max_title_size_pt": 44
  },
  "layout_rules": {
    "density": "medium-low",
    "grid": "12-column",
    "margin": "generous",
    "chart_preference": ["big-number", "line", "process"],
    "avoid": ["dense_tables", "small_body_text", "too_many_competing_accents"]
  },
  "default_slide_types": [
    "cover",
    "section",
    "big-number",
    "comparison",
    "process",
    "image",
    "closing"
  ]
}

